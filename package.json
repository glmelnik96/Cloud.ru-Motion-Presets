{
  "name": "cloudru-brandkit",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Cloud.ru BrandKit: brand templates and presets for After Effects and Premiere",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "lint:jsx": "node tools/jsx/lint-jsx.cjs",
    "spike:report": "node tools/spike/report.mjs",
    "library:validate": "node tools/library/validate.mjs library/library.src.json",
    "library:build": "node tools/library/build-catalog.mjs",
    "library:style": "node tools/library/style-pack.mjs",
    "typecheck": "tsc -p panel/tsconfig.json",
    "panel:live": "node tools/panel/live.mjs",
    "panel:checkpoint": "node tools/panel/checkpoint.mjs",
    "materials": "node tools/dump/materials.mjs",
    "panel:build": "vite build --config panel/vite.config.mjs",
    "panel:dev": "vite --config panel/vite.config.mjs",
    "installer:build": "node tools/installer/build.mjs"
  },
  "devDependencies": {
    "adm-zip": "^0.6.1",
    "ajv": "^8.20.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "preact": "^11.0.0"
  }
}
